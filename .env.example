# Server-side only. Never prefix secrets with NEXT_PUBLIC_ and never commit a real value.
# Live Qloo calls default to direct REST against the hackathon base URL (hackathon keys 401 anywhere else).
# Set QLOO_TRANSPORT=harness to use the official CLI (`qloo api`) instead.
QLOO_API_KEY=
QLOO_TRANSPORT=rest
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_CLI=qloo
QLOO_TIMEOUT_MS=15000
WEAVE_DEFAULT_MODE=demo
WEAVE_ANALYSES_PER_MINUTE=30
WEAVE_LOG=info
PORT=3000
