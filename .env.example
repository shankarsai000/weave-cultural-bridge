# Server-side only. Never prefix secrets with NEXT_PUBLIC_ and never commit a real value.
# Live Qloo calls use the event's permitted surface: the official harness (qloo api).
# Preferred: run `qloo setup --qloo` once. Alternative: QLOO_API_KEY, which the harness reads (this code never does).
QLOO_API_KEY=
QLOO_CLI=qloo
QLOO_TIMEOUT_MS=15000
WEAVE_DEFAULT_MODE=demo
WEAVE_ANALYSES_PER_MINUTE=30
WEAVE_LOG=info
PORT=3000
